loki.source.file "dev_tomcat" {
  targets = [
    {
      __path__ = "/opt/tomcat/logs/catalina.out",
      source   = "dedicated",
      host     = "hetzner",
      env      = "dev",
      service  = "tomcat",
    },
  ]

  forward_to = [loki.write.cluster.receiver]
}

loki.source.file "dev_postgres" {
  targets = [
    {
      __path__ = "/var/log/postgresql/*.log",
      source   = "dedicated",
      host     = "hetzner",
      env      = "dev",
      service  = "postgres",
    },
  ]

  forward_to = [loki.write.cluster.receiver]

  file_match {
    enabled     = true
    sync_period = "30s"
  }
}

loki.write "cluster" {
  endpoint {
    url = "https://grafana.k8s.zazer.fun/loki/api/v1/push"

    basic_auth {
      username = "alloy"
      password = "__DEDICATED_LOGS_PASSWORD__"
    }
  }
}
